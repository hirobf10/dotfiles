#!/bin/bash
# Expand herdr's bundled agent skill into ~/.agents/skills/herdr.
#
# `herdr --skill` (0.8.0+) prints the skill shipped inside the running binary, so
# the skill always matches the installed herdr instead of a pinned copy fetched
# from GitHub. The version below is interpolated at apply time, so upgrading herdr
# changes this script and chezmoi re-runs it.
#
# The binary is located without relying on PATH: Homebrew on Linux installs to
# linuxbrew, which is not on PATH while chezmoi applies, and a version that
# appeared only afterwards would leave this script pending on the next verify.
{{- $herdr := lookPath "herdr" -}}
{{- if not $herdr -}}
{{-   range list "/opt/homebrew/bin/herdr" "/home/linuxbrew/.linuxbrew/bin/herdr" "/usr/local/bin/herdr" -}}
{{-     if and (not $herdr) (stat .) -}}
{{-       $herdr = . -}}
{{-     end -}}
{{-   end -}}
{{- end }}

set -eu

# Runs standalone from any shell: brew's bin is not on bash's default PATH
export PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

{{ if $herdr -}}
# version: {{ output $herdr "--version" | trim }}
if ! command -v herdr >/dev/null 2>&1; then
    echo "⚠️  herdr not found; skipping bundled skill" >&2
    exit 0
fi

# --skill needs herdr 0.8.0+; skip quietly on older versions rather than
# leaving a truncated SKILL.md behind
tmp="$(mktemp)"
if herdr --skill >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    dir="$HOME/.agents/skills/herdr"
    mkdir -p "$dir"
    mv "$tmp" "$dir/SKILL.md"
    echo "🐑 Wrote the herdr agent skill to $dir/SKILL.md"
else
    rm -f "$tmp"
    echo "⚠️  herdr --skill unavailable (needs 0.8.0+); skipping the bundled agent skill" >&2
fi
{{- else -}}
# herdr is not installed yet; setup.sh writes the skill after installing it.
:
{{- end }}
