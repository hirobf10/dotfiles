#!/bin/sh
# Global pre-push hook (core.hooksPath): chain to the repository's own hook.
# Resolve via --git-dir, NOT --git-path hooks/...: the latter follows
# core.hooksPath back to this very script and recurses forever.

repo_hook="$(git rev-parse --git-dir)/hooks/pre-push"
if [ -x "$repo_hook" ]; then
    exec "$repo_hook" "$@"
fi
